# Freestyle API key (dash.freestyle.sh, or `npx freestyle tokens create pods`)
FREESTYLE_API_KEY=
# Injected at the Freestyle edge on POST api.anthropic.com/v1/messages; never enters a VM.
ANTHROPIC_API_KEY=
# Optional, fine-grained, scoped to the repos you bake: injected at the edge for github.com (private clones, `pods push`).
PODS_GITHUB_TOKEN=
